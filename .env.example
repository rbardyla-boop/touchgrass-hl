# TOUCHGRASS-HL v0.1
# Copy to .env. .env is gitignored. Never commit secrets.

# SQLite file. Relative paths are resolved from the working directory.
DATABASE_URL=sqlite:///data/touchgrass.db
LOG_DIR=logs
LOG_LEVEL=INFO

# Public mainnet data only. This URL is not used for order signing.
HL_INFO_URL=https://api.hyperliquid.xyz
HL_WS_URL=wss://api.hyperliquid.xyz/ws

# paper (default) or testnet. Any other value, including mainnet, refuses to start.
EXECUTION_MODE=paper
TRADING_KILL_SWITCH=false

# Optional. Required only for EXECUTION_MODE=testnet.
# The private key is an API/agent wallet. It is never logged.
TESTNET_API_URL=https://api.hyperliquid-testnet.xyz
TESTNET_ACCOUNT_ADDRESS=
TESTNET_AGENT_PRIVATE_KEY=
# Kept for configuration compatibility. v0.1 does not mirror paper signals
# onto testnet. Use `touchgrass-hl testnet-smoke` for the one controlled order.
TESTNET_AUTO_TRADE=false
TESTNET_MAX_NOTIONAL_USD=15

# Optional Jev review. The bot runs fully with this false.
JEV_ENABLED=false
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_BASE_URL=https://api.typesafe.ai

# Universe. Empty allowlist means discover markets and subscribe to the
# highest-volume names up to MAX_TRADE_SUBSCRIPTIONS. Do not hard-code coins.
MAX_TRADE_SUBSCRIPTIONS=80
MARKET_ALLOWLIST=
MARKET_DENYLIST=
MARKET_REFRESH_SECONDS=120

# Wallet hydration. Expensive history calls wait until these are met.
MIN_TRADES_TO_HYDRATE=8
MIN_NOTIONAL_TO_HYDRATE=5000
HYDRATION_MAX_PER_HOUR=30
HYDRATION_LOOKBACK_DAYS=90

# Verification baselines. Research settings, not optimized parameters.
MIN_CLOSED_TRADES=30
MIN_ACTIVE_DAYS=14
MAX_PROFIT_CONCENTRATION=0.50
ALLOW_PROFIT_CONCENTRATION_OVERRIDE=false

# Score weights. Must sum to 1.
WEIGHT_PROFITABILITY=0.20
WEIGHT_PROFIT_FACTOR=0.15
WEIGHT_CONSISTENCY=0.15
WEIGHT_COPYABILITY=0.15
WEIGHT_WIN_RATE=0.10
WEIGHT_INVERSE_DRAWDOWN=0.10
WEIGHT_INVERSE_CONCENTRATION=0.10
WEIGHT_DATA_QUALITY=0.05

# Convergence.
CLUSTER_WINDOW_SECONDS=120
CLUSTER_MIN_GROUPS=3
SIGNAL_COOLDOWN_SECONDS=900

# Paper account. 1x notional, no leverage.
PAPER_STARTING_EQUITY=75
PAPER_TARGET_NOTIONAL=5
PAPER_MAX_POSITIONS=2
PAPER_STOP_LOSS_PCT=0.01
PAPER_TAKE_PROFIT_PCT=0.02
PAPER_MAX_HOLD_SECONDS=3600

# Fees are configured assumptions, stored on every simulated fill.
# Core tier-0 taker 4.5 bps / maker 1.5 bps.
# HIP-3 growth uses the top of the published all-in band (0.9 bps taker).
# HIP-3 otherwise uses 4x protocol tier-0 because deployer fee share is unknown.
FEE_TAKER_RATE=0.00045
FEE_MAKER_RATE=0.00015
FEE_HIP3_GROWTH_TAKER_RATE=0.00009
FEE_HIP3_GROWTH_MAKER_RATE=0.00003
FEE_HIP3_STANDARD_TAKER_RATE=0.00180
FEE_HIP3_STANDARD_MAKER_RATE=0.00060

# Hard vetoes.
MAX_SPREAD_BPS=15
MAX_SLIPPAGE_BPS=20
MAX_PRICE_MOVE_SINCE_FIRST_BPS=30
STALE_MARKET_SECONDS=15
DAILY_LOSS_LIMIT_USD=5
MAX_DRAWDOWN_PCT=0.20

# Retention. Audit rows, candidates, scores, and paper results are kept.
TRADE_RETENTION_DAYS=14
SNAPSHOT_RETENTION_HOURS=24

# REST budget kept under Hyperliquid's 1200 weight/minute IP limit.
INFO_WEIGHT_PER_MINUTE=1000
